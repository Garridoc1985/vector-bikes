---
import TallerLayout from "../../layouts/TallerLayout.astro";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../server/auth/admin-auth.ts";
import { can, forbiddenResponse, ROLE_LABELS } from "../../server/auth/permissions.ts";
import { getDb } from "../../server/db/client.ts";
import { formatClp } from "../../server/email/templates.ts";
import { adminDashboard, mechanicDashboard } from "../../server/taller/dashboard.ts";
import type { DashboardOrder } from "../../server/taller/dashboard.ts";

export const prerender = false;

const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user) return Astro.redirect(loginRedirect(Astro.url.pathname + Astro.url.search), 303);
if (!can(user.role, "orders.edit")) return forbiddenResponse();

Astro.response.headers.set("cache-control", "no-store");
const { name, role } = user;
const admin = can(role, "dashboard.admin") ? await adminDashboard(db, user, now) : null;
const mechanic = can(role, "dashboard.mechanic") ? await mechanicDashboard(db, user, now) : null;
type AdminDashboard = NonNullable<Awaited<ReturnType<typeof adminDashboard>>>;
type DashboardSection = { id: string; title: string } & (
  | { orders: (DashboardOrder & { balance?: number })[] }
  | { bookings: AdminDashboard["bookingsToday"] }
  | { income: number }
  | { mechanics: AdminDashboard["loadByMechanic"] }
);
function orderSection(
  id: string,
  title: string,
  orders: (DashboardOrder & { balance?: number })[],
) {
  return { id, title, orders };
}
const sections: DashboardSection[] = admin
  ? [
      { id: "bookingsToday", title: "Reservas de hoy", bookings: admin.bookingsToday },
      ...(admin.incomeTodayClp === null
        ? []
        : [{ id: "incomeToday", title: "Ingresos de hoy", income: admin.incomeTodayClp }]),
      orderSection("inWorkshop", "Bicicletas en taller", admin.inWorkshop),
      orderSection("waitingApproval", "Esperando aprobación", admin.waitingApproval),
      orderSection("waitingParts", "Esperando repuesto", admin.waitingParts),
      orderSection("inRepair", "En reparación", admin.inRepair),
      orderSection("qcPending", "Control de calidad pendiente", admin.qcPending),
      orderSection("readyForPickup", "Listas para retiro", admin.readyForPickup),
      orderSection("overdue", "Atrasadas", admin.overdue),
      orderSection("upcomingDeliveries", "Próximas entregas", admin.upcomingDeliveries),
      { id: "loadByMechanic", title: "Carga por mecánico", mechanics: admin.loadByMechanic },
      ...(admin.pendingPayments === null
        ? []
        : [orderSection("pendingPayments", "Pagos pendientes", admin.pendingPayments)]),
    ]
  : mechanic
    ? [
        {
          id: "upcomingIntakes",
          title: "Próximos ingresos",
          bookings: mechanic.upcomingIntakes.map(({ customerFirstName, ...booking }) => ({
            ...booking,
            customerName: customerFirstName,
          })),
        },
        orderSection("assigned", "Bicicletas asignadas", mechanic.assigned),
        orderSection("pending", "Trabajos pendientes", mechanic.pending),
        orderSection("overdue", "Atrasados", mechanic.overdue),
        orderSection("waitingApproval", "Esperando aprobación", mechanic.waitingApproval),
        orderSection("waitingParts", "Esperando repuesto", mechanic.waitingParts),
        orderSection("dueSoon", "Próximos a entrega", mechanic.dueSoon),
        orderSection("qcPending", "Control de calidad pendiente", mechanic.qcPending),
        orderSection("unassigned", "Sin asignar", mechanic.unassigned),
      ]
    : [];
---

<TallerLayout title="Taller — Vector Bikes" description="Área interna del taller." path="/taller" user={user}>
  <h1>Taller</h1>
  <p>Hola, {name} · {ROLE_LABELS[role]}</p>
  {sections.map((section) => (
    <section aria-labelledby={`dashboard-${section.id}`}>
      <h2 id={`dashboard-${section.id}`}>{section.title}</h2>
      {"income" in section && <p>{formatClp(section.income)}</p>}
      {"bookings" in section && (section.bookings.length ? (
        <ul>{section.bookings.map((booking) => (
          <li><time datetime={booking.serviceDate}>{booking.serviceDate}</time> · {booking.time} · {booking.customerName} · {booking.service}</li>
        ))}</ul>
      ) : <p>Sin reservas.</p>)}
      {"orders" in section && (section.orders.length ? (
        <ul>{section.orders.map((order) => (
          <li>
            <a href={`/taller/ordenes/${order.id}`}>{order.number}</a>
            <span class={`status status--${order.status}`}>{order.statusLabel}</span>
            <p>{order.customerName} · {order.bike}</p>
            <p>{order.mechanicName ?? "Sin mecánico"} · {order.estimatedDeliveryDate ? <time datetime={order.estimatedDeliveryDate}>{order.estimatedDeliveryDate}</time> : "Sin fecha"}</p>
            {order.balance !== undefined && <p>Saldo: {formatClp(order.balance)}</p>}
          </li>
        ))}</ul>
      ) : <p>Sin órdenes.</p>)}
      {"mechanics" in section && (section.mechanics.length ? (
        <table class="dense">
          <thead><tr><th scope="col">Mecánico</th><th scope="col">Órdenes abiertas</th><th scope="col">Minutos</th></tr></thead>
          <tbody>{section.mechanics.map((load) => (
            <tr><th scope="row">{load.name}</th><td>{load.openOrders}</td><td>{load.minutes}</td></tr>
          ))}</tbody>
        </table>
      ) : <p>Sin mecánicos activos.</p>)}
    </section>
  ))}
</TallerLayout>
