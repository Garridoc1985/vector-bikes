---
import { z } from "zod";
import Card from "../../../../components/taller/Card.astro";
import OrderTabs from "../../../../components/taller/OrderTabs.astro";
import PageHeader from "../../../../components/taller/PageHeader.astro";
import ReportView from "../../../../components/taller/ReportView.astro";
import TallerLayout from "../../../../layouts/TallerLayout.astro";
import { ORDER_TABS } from "../../../../lib/taller-tabs.ts";
import { getSiteEnv } from "../../../../lib/env.ts";
import { isAllowedOrigin } from "../../../../server/api/handlers.ts";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../../../server/auth/permissions.ts";
import { getDb } from "../../../../server/db/client.ts";
import { getStorage } from "../../../../server/storage/storage.ts";
import { whatsappShareLink } from "../../../../server/taller/approvals.ts";
import { formatOrderNumber } from "../../../../server/taller/orders.ts";
import {
  generateReport,
  getReportAftercare,
  getReportForStaff,
  loadReportPhotos,
  reportFormSchema,
} from "../../../../server/taller/reports.ts";
import { orderDetail } from "../../../../server/taller/status.ts";
import { STATUS_LABELS } from "../../../../server/taller/rules.ts";
import type { OrderStatus } from "../../../../server/taller/rules.ts";

export const prerender = false;
const headers = { "cache-control": "no-store", "referrer-policy": "no-referrer" };
function forbidden() {
  const response = forbiddenResponse();
  response.headers.set("referrer-policy", "no-referrer");
  return response;
}
function notFound() {
  return new Response('<p role="alert">Orden no encontrada.</p>', {
    status: 404,
    headers: { ...headers, "content-type": "text/html; charset=utf-8" },
  });
}
const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user)
  return new Response(null, {
    status: 303,
    headers: { ...headers, location: loginRedirect(Astro.url.pathname) },
  });
if (!can(user.role, "reports.generate")) return forbidden();
if (Astro.request.method === "POST" && !isAllowedOrigin(Astro.request)) return forbidden();
for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success) return notFound();
const detail = await orderDetail(db, user, id.data);
if (!detail.ok) return detail.code === "forbidden" ? forbidden() : notFound();
let report = await getReportForStaff(db, user, id.data);
let values = {
  recommendations:
    report?.snapshot.recommendations ?? (await getReportAftercare(db, user, id.data)),
  nextChecks: report?.snapshot.nextChecks ?? "",
};
let error = "";
let link = "";
let whatsapp = "";
const fieldErrors = new Set<string>();
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  values = {
    recommendations: String(form.get("recommendations") ?? ""),
    nextChecks: String(form.get("nextChecks") ?? ""),
  };
  const parsed = reportFormSchema.safeParse(values);
  const result = parsed.success
    ? await generateReport(db, user, id.data, parsed.data, now)
    : ({ ok: false, code: "validation_error" } as const);
  if (result.ok) {
    link = `${getSiteEnv().PUBLIC_SITE_URL.replace(/\/$/, "")}/informe/${result.token}`;
    const firstName = detail.customer.name.trim().split(/\s+/)[0];
    if (detail.customer.phoneE164)
      whatsapp = whatsappShareLink(
        detail.customer.phoneE164,
        `Hola ${firstName}, aquí está el informe del servicio de tu bicicleta en Vector Bikes: ${link}`,
      );
    report = await getReportForStaff(db, user, id.data);
    if (report)
      values = {
        recommendations: report.snapshot.recommendations,
        nextChecks: report.snapshot.nextChecks,
      };
  } else {
    if (result.code === "forbidden") return forbidden();
    if (result.code === "not_found") return notFound();
    Astro.response.status = result.code === "validation_error" ? 422 : 409;
    error =
      result.code === "validation_error"
        ? "Recomendaciones y próximas revisiones admiten hasta 2000 caracteres."
        : "El informe se genera cuando la orden está Lista para retirar o Entregada.";
    if (!parsed.success)
      for (const issue of parsed.error.issues) fieldErrors.add(String(issue.path[0]));
  }
}
const photos = report ? await loadReportPhotos(await getStorage(), report.snapshot) : {};
const number = formatOrderNumber(detail.order.number);
const fields = [
  { key: "recommendations", label: "Recomendaciones" },
  { key: "nextChecks", label: "Próximas revisiones" },
] as const;
const { order } = detail;
const tabs = ORDER_TABS.filter((tab) => can(user.role, tab.permission));
---

<TallerLayout title={`${number} · Informe — Vector Bikes`} description="Informe final del servicio de la bicicleta." path="/taller/ordenes" user={user}>
  <div class="stack">
    <PageHeader title={`${number} · Informe`} status={{ status: order.status, label: STATUS_LABELS[order.status as OrderStatus] }} />
    <OrderTabs orderId={order.id} active="informe" tabs={tabs} />
    {error && <p id="form-error" role="alert">{error}</p>}
    {link && <Card id="share-title" title="Enlace para el cliente">
      <p role="status">Copia este enlace ahora; se muestra solo una vez. Regenerar el informe invalida el enlace anterior.</p>
      <div class="field"><label for="report-link">Enlace del informe</label><textarea id="report-link" readonly rows="3">{link}</textarea></div>
      <p><a class="btn" href={whatsapp} target="_blank" rel="noopener noreferrer">Enviar por WhatsApp</a></p>
    </Card>}
    <Card><form method="post" action={Astro.url.pathname}>
      <fieldset><legend>Informe final</legend><div class="fields">
        {fields.map(({ key, label }) => <div class="field">
          <label for={key}>{label}</label>
          <textarea id={key} name={key} rows="4" maxlength="2000" aria-invalid={fieldErrors.has(key)} aria-describedby={fieldErrors.has(key) ? "form-error" : undefined}>{values[key]}</textarea>
        </div>)}
      </div><button class="btn" type="submit">{report ? "Regenerar informe" : "Generar informe"}</button></fieldset>
    </form></Card>
    {report && <Card><ReportView snapshot={report.snapshot} photos={photos} /></Card>}
  </div>
</TallerLayout>
