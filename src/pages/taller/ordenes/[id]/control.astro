---
import { z } from "zod";
import Card from "../../../../components/taller/Card.astro";
import OrderTabs from "../../../../components/taller/OrderTabs.astro";
import PageHeader from "../../../../components/taller/PageHeader.astro";
import TallerLayout from "../../../../layouts/TallerLayout.astro";
import { ORDER_TABS } from "../../../../lib/taller-tabs.ts";
import { isAllowedOrigin } from "../../../../server/api/handlers.ts";
import { loginRedirect, requireAdmin, SESSION_COOKIE } from "../../../../server/auth/admin-auth.ts";
import { can, forbiddenResponse } from "../../../../server/auth/permissions.ts";
import { getDb } from "../../../../server/db/client.ts";
import { formatOrderNumber } from "../../../../server/taller/orders.ts";
import { listQcChecks, qcFormSchema, submitQc } from "../../../../server/taller/qc.ts";
import {
  QC_CHECK_KEYS,
  QC_CHECK_LABELS,
  QC_RESULTS,
  QC_RESULT_LABELS,
  STATUS_LABELS,
} from "../../../../server/taller/rules.ts";
import type { OrderStatus } from "../../../../server/taller/rules.ts";
import { orderDetail } from "../../../../server/taller/status.ts";

export const prerender = false;
const db = getDb();
const now = new Date();
const user = await requireAdmin(db, Astro.cookies.get(SESSION_COOKIE)?.value, now);
if (!user)
  return new Response(null, {
    status: 303,
    headers: {
      location: loginRedirect(Astro.url.pathname + Astro.url.search),
      "cache-control": "no-store",
    },
  });
if (Astro.request.method === "POST") {
  if (!isAllowedOrigin(Astro.request)) return forbiddenResponse();
  if (!can(user.role, "qc.approve")) return forbiddenResponse();
}
if (!can(user.role, "orders.edit")) return forbiddenResponse();
Astro.response.headers.set("cache-control", "no-store");
const id = z.uuid().safeParse(Astro.params.id);
if (!id.success)
  return new Response("Orden no encontrada.", {
    status: 404,
    headers: { "cache-control": "no-store" },
  });
const detail = await orderDetail(db, user, id.data);
if (!detail.ok) {
  if (detail.code === "forbidden") return forbiddenResponse();
  return new Response("Orden no encontrada.", {
    status: 404,
    headers: { "cache-control": "no-store" },
  });
}
const { order } = detail;
const number = formatOrderNumber(order.number);
let submitted: Record<string, string> = {};
const fieldErrors: Record<string, string> = {};
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = Object.fromEntries([...form].map(([key, value]) => [key, String(value)]));
  const checks = Object.fromEntries(
    QC_CHECK_KEYS.map((key) => [
      key,
      {
        result: submitted[key],
        note: submitted[`${key}_nota`] ?? "",
      },
    ]),
  );
  const parsed = qcFormSchema.safeParse({ checks });
  if (!parsed.success) {
    Astro.response.status = 422;
    error = "Revisa los puntos del control de calidad.";
    for (const issue of parsed.error.issues) {
      const key = `${String(issue.path[1])}${issue.path[2] === "note" ? "_nota" : ""}`;
      fieldErrors[key] ??= issue.message;
    }
  } else {
    const result = await submitQc(db, user, order.id, parsed.data, now);
    if (result.ok)
      return new Response(null, {
        status: 303,
        headers: {
          location: `${Astro.url.pathname}?hecho=${result.status === "lista_para_retirar" ? "aprobado" : "rechazado"}`,
          "cache-control": "no-store",
        },
      });
    if (result.code === "forbidden") return forbiddenResponse();
    Astro.response.status = result.code === "validation_error" ? 422 : 409;
    error =
      result.code === "second_person_required"
        ? "El control requiere una segunda persona."
        : result.code === "invalid_status"
          ? "La orden debe estar en control de calidad."
          : "Revisa los puntos del control de calidad.";
  }
}
const history = await listQcChecks(db, user, order.id);
const tabs = ORDER_TABS.filter((tab) => can(user.role, tab.permission));
---

<TallerLayout title={`${number} · Control de calidad — Vector Bikes`} description="Control de calidad e historial de revisiones." path="/taller/ordenes" user={user}>
  <div class="stack">
    <PageHeader title={`${number} · Control de calidad`} status={{ status: order.status, label: STATUS_LABELS[order.status as OrderStatus] }} />
    <OrderTabs orderId={order.id} active="control" tabs={tabs} />
    {error && <p role="alert">{error}</p>}
    {Astro.url.searchParams.get("hecho") === "aprobado" && <p role="status">Control de calidad aprobado.</p>}
    {Astro.url.searchParams.get("hecho") === "rechazado" && <p role="status">Control rechazado. La orden vuelve a reparación.</p>}
    <Card>
      {can(user.role, "qc.approve") ? (
        order.status === "control_calidad" ? (
          <form method="post" action={Astro.url.pathname}>
            <div class="fields">
              {QC_CHECK_KEYS.map((key) => (
                <fieldset>
                  <legend>{QC_CHECK_LABELS[key]}</legend>
                  <div class="options">
                    {QC_RESULTS.map((result) => (
                      <label><input type="radio" name={key} value={result} required checked={submitted[key] === result} aria-invalid={Boolean(fieldErrors[key])} aria-describedby={fieldErrors[key] ? `${key}-error` : undefined} />{QC_RESULT_LABELS[result]}</label>
                    ))}
                  </div>
                  {fieldErrors[key] && <p id={`${key}-error`}>{fieldErrors[key]}</p>}
                  <div class="field">
                    <label for={`${key}-note`}>Nota de {QC_CHECK_LABELS[key]} (opcional)</label>
                    <input id={`${key}-note`} name={`${key}_nota`} type="text" maxlength="300" value={submitted[`${key}_nota`] ?? ""} aria-invalid={Boolean(fieldErrors[`${key}_nota`])} aria-describedby={fieldErrors[`${key}_nota`] ? `${key}-note-error` : undefined} />
                    {fieldErrors[`${key}_nota`] && <p id={`${key}-note-error`}>{fieldErrors[`${key}_nota`]}</p>}
                  </div>
                </fieldset>
              ))}
            </div>
            <button type="submit" class="btn">Aprobar control</button>
          </form>
        ) : <p class="muted">La orden debe estar en control de calidad para registrar una revisión.</p>
      ) : <p class="muted">Solo el dueño aprueba el control de calidad</p>}
    </Card>
    <Card id="history-heading" title="Historial de controles">
      {history.length === 0 ? <p class="muted">No hay controles registrados.</p> : (
        <ul class="log">{history.map((check) => (
          <li>
            <p>{check.createdAt.toLocaleString("es-CL", { timeZone: "America/Santiago" })} · {QC_CHECK_LABELS[check.itemKey as (typeof QC_CHECK_KEYS)[number]]}: {QC_RESULT_LABELS[check.result as (typeof QC_RESULTS)[number]]}{check.selfCheck ? " · Autocontrol" : ""}</p>
            {check.note && <p class="muted">{check.note}</p>}
          </li>
        ))}</ul>
      )}
    </Card>
  </div>
</TallerLayout>
